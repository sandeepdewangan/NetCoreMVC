@model List<Category>

<partial name="_Notification" />

<h1>Category List</h1>
<br />
<a asp-controller="Category" asp-action="Create" class="btn btn-outline-primary">Add Category</a>
<br />
<br />
<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Category Name</th>
            <th>Display Order</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.DisplayOrder</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Update" asp-route-id="@category.Id">Update</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@category.Id">Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>

@section Scripts{
    <script>
        setTimeout(function () {
            var alert = document.getElementById('autoAlert');
            if (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 3000); // 3000 ms = 3 seconds
    </script>
}