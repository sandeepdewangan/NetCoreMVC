@using NetCore.Models
@model Category

<div class="container mt-5">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Delete Category</h4>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Delete">

                <!-- Category Id (Hidden) -->
                <input asp-for="Id" hidden />

                <!-- Category Name -->
                <div class="mb-3">
                    <label for="categoryName" class="form-label">Category Name</label>
                    <input type="text" class="form-control" asp-for="Name" placeholder="Enter category name" readonly>
                </div>

                <!-- Display Order -->
                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                    <input type="number" class="form-control" asp-for="DisplayOrder" placeholder="Enter display order" readonly>
                </div>

                <!-- Submit Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="submit" class="btn btn-outline-dark">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
